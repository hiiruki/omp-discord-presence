{
  "name": "omp-discord-presence",
  "packageManager": "pnpm@12.16.1",
  "version": "0.3.0",
  "description": "Discord Rich Presence for omp (oh-my-pi): live status, model logos, GitHub button, subagent party and privacy controls. Works on Windows, macOS, Linux and WSL.",
  "author": "Hiiruki",
  "type": "module",
  "keywords": [
    "omp-package",
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "discord",
    "discord-rpc",
    "rich-presence",
    "discord-presence",
    "coding-agent",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hiiruki/omp-discord-presence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiiruki/omp-discord-presence.git"
  },
  "bugs": {
    "url": "https://github.com/hiiruki/omp-discord-presence/issues"
  },
  "files": [
    "extensions",
    "bin",
    "assets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint extensions scripts test",
    "test": "bun test",
    "sync-icons": "bun scripts/sync-model-icons.ts"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-catalog": "^18.14.2",
    "@oh-my-pi/pi-coding-agent": "^18.14.2",
    "@oh-my-pi/pi-utils": "^18.14.2",
    "@types/bun": "^1.4.4",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-utils": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./extensions/discord-presence.ts"
    ]
  }
}
