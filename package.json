{
  "name": "omp-discord-presence",
  "version": "0.1.0",
  "description": "Discord Rich Presence extension for omp (oh-my-pi) coding agent.",
  "author": "Hiiruki",
  "type": "module",
  "keywords": [
    "omp-package",
    "omp",
    "oh-my-pi",
    "discord",
    "rich-presence"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "bin",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint extensions"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.14.2",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^24.0.0",
